# Model provider key — set ONE of these (whichever matches MODEL below)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Model router id in "provider/model" form. Mastra resolves the provider from the prefix.
# Examples: anthropic/claude-sonnet-5-5, anthropic/claude-haiku-5-5, openai/gpt-6.1-sol
MODEL=anthropic/claude-sonnet-5-5
